# Postgres (local Docker): postgres listens on 5432 inside the container, so map
# host 5555 -> container 5432. Run with:
#   docker run -d --name chat-postgres -e POSTGRES_USER=chat -e POSTGRES_PASSWORD=chat -e POSTGRES_DB=chat-app -p 5555:5432 postgres:16-alpine
DATABASE_URL="postgresql://chat:chat@localhost:5555/chat-app?sslmode=disable"

# Auth
JWT_SECRET="MFFMj5jcfI6t0FRClYL7AM9iCEcUv5wcRjx4Ne-BsW3-THM8Vlngqw_PVGDcpDrk"

# Frontend origin allowed for CORS
FRONTEND_URL="http://localhost:5173"

# Cloudflare R2 (S3-compatible) - optional; image upload returns 503 until configured
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""

PORT=3000