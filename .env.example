# Postgres (Neon / Supabase free tier)
DATABASE_URL="postgresql://user:password@host:5555/dbname?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# Frontend origin allowed for CORS
FRONTEND_URL="http://localhost:5173"

# Image storage: Railway Bucket (private, S3-compatible). Copy the values from the
# bucket's Credentials tab. Uploads return 503 until these are set.
S3_ENDPOINT="https://storage.railway.app"
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Public origin of this API, used to build image URLs (<PUBLIC_URL>/api/files/...).
# Defaults to https://$RAILWAY_PUBLIC_DOMAIN on Railway, http://localhost:$PORT otherwise.
# PUBLIC_URL="http://localhost:3000"

PORT=3000
