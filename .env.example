# Postgres (Neon / Supabase free tier)
DATABASE_URL="postgresql://user:password@host:5555/dbname?sslmode=require"

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# Frontend origin allowed for CORS
FRONTEND_URL="http://localhost:5173"

# Cloudflare R2 (S3-compatible)
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="chat-app-images"
R2_PUBLIC_BASE_URL="https://<your-public-r2-domain>"

PORT=3000
